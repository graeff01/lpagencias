<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
  <%
    var base = comoAdmin ? '/admin/equipes/' + gestor.id : '/gestor';
    var rotulo = periodos.find(function(p){ return p[0] === per.chave; })[1];
    var fmt = function(d){ return d ? new Date(d).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—'; };
    var media = total.corretores ? (total.leads / total.corretores) : 0;
    var maxEmp = porEmp.reduce(function(m, e){ return Math.max(m, e.leads); }, 0);
  %>
  <header class="topbar">
    <a class="brand" href="<%= comoAdmin ? '/admin' : '/gestor' %>"><span class="m"><svg viewBox="0 0 24 24" fill="none"><path d="M4 11L12 4l8 7v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1v-8Z" fill="#fff"/></svg></span><span>Auxiliadora<small>Painel do gestor</small></span></a>
    <div class="sp"></div>
    <div class="top-links">
      <% if (comoAdmin) { %>
        <a class="btn btn-ghost btn-sm" href="/admin/equipes">Equipes</a>
        <form method="POST" action="/admin/logout"><button class="btn btn-ghost btn-sm" type="submit">Sair</button></form>
      <% } else { %>
        <% if (typeof podeAdmin !== "undefined" && podeAdmin) { %><a class="btn btn-primary btn-sm" href="/gestor/admin">Painel admin</a><% } %>
        <a class="btn btn-ghost btn-sm" href="/gestor/senha">Alterar senha</a>
        <form method="POST" action="/gestor/logout"><button class="btn btn-ghost btn-sm" type="submit">Sair</button></form>
      <% } %>
    </div>
  </header>

  <div class="wrap">
    <% if (comoAdmin) { %>
      <div class="warn-box">Você está vendo o painel exatamente como <b><%= gestor.nome %></b> vê (usuário <b><%= gestor.usuario %></b>, acesso em <b>/gestor</b>).</div>
    <% } %>

    <div class="page-head">
      <div>
        <div class="eyebrow">Equipe <%= gestor.nome %></div>
        <h1>Leads por corretor</h1>
        <p>Quantas pessoas clicaram em “entrar em contato” e caíram no WhatsApp de cada corretor da equipe, somando todos os empreendimentos.</p>
      </div>
    </div>

    <nav class="chips" style="margin-bottom:18px" aria-label="Período">
      <% periodos.forEach(function(p){ %>
        <a class="chip <%= p[0] === per.chave ? 'on' : '' %>" href="<%= base %>?periodo=<%= p[0] %>"><%= p[1] %></a>
      <% }); %>
    </nav>

    <% if (!linhas.length) { %>
      <div class="warn-box">Nenhum corretor foi ligado a esta equipe ainda. O administrador faz isso em <b>Painel → Equipes</b>.</div>
    <% } %>

    <div class="kpis">
      <div class="kpi"><span>Leads · <%= rotulo.toLowerCase() %></span><b><%= total.leads %></b><i>pessoas distintas que chamaram a equipe</i></div>
      <div class="kpi"><span>Média por corretor</span><b><%= media.toFixed(1).replace('.', ',') %></b><i><%= total.corretores %> corretor(es) na equipe</i></div>
      <div class="kpi"><span>Pela recepção</span><b><%= total.recepcao %></b><i><% if (total.confirmados || total.semConfirmar) { %><%= total.confirmados %> confirmado(s) pelo corretor<% if (total.tempoMedio != null) { %> · em média <%= duracao(total.tempoMedio) %><% } %><% if (total.semConfirmar) { %> · <b style="color:var(--danger);font-size:inherit;display:inline;font-weight:700"><%= total.semConfirmar %> sem confirmar</b><% } %><% } else { %>leads que a recepção encaminhou<% } %></i></div>
      <div class="kpi"><span>Não retornou</span><b><%= total.nao_retornados %></b><i>voltaram após 24h e trocaram de corretor</i></div>
    </div>

    <div class="panel">
      <h2 class="panel-h">Distribuição · <%= rotulo.toLowerCase() %></h2>
      <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Corretor</th><th>Leads</th><th>Participação</th><th>Recepção</th><th>Resgatou</th><th>Não retornou</th><th>Último lead</th><th>Por empreendimento</th></tr></thead>
        <tbody>
          <% if (!linhas.length) { %><tr><td colspan="8" class="empty">Sem corretores na equipe.</td></tr><% } %>
          <% linhas.forEach(function(l){ var pct = total.leads ? (l.leads * 100 / total.leads) : 0; %>
            <tr class="<%= l.ativo ? '' : 'off' %>">
              <td>
                <b><%= l.nome %></b>
                <% if (!l.ativo) { %><span class="tag pause"><%= l.naRoleta ? 'pausado' : 'inativo' %></span><% } else if (!l.naRoleta) { %><span class="tag">só recepção</span><% } %>
                <span class="sub mono"><%= l.telefone.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3') %></span>
              </td>
              <td class="num big"><%= l.leads %></td>
              <td>
                <div class="bar"><span style="width:<%= Math.min(100, pct).toFixed(1) %>%"></span></div>
                <span class="sub"><%= pct.toFixed(1).replace('.', ',') %>%</span>
              </td>
              <td class="num"><%= l.recepcao %><% if (l.confirmados || l.semConfirmar) { %><span class="sub" style="font-weight:500"><%= l.confirmados %> ✓<% if (l.tempoMedio != null) { %> · <%= duracao(l.tempoMedio) %><% } %><% if (l.semConfirmar) { %> · <span style="color:var(--danger)"><%= l.semConfirmar %> sem confirmar</span><% } %></span><% } %></td>
              <td class="num"><%= l.resgatados %></td>
              <td class="num" <% if (l.nao_retornados) { %>style="color:var(--danger)"<% } %>><%= l.nao_retornados %></td>
              <td class="sub"><%= fmt(l.ultimo) %></td>
              <td class="sub">
                <% if (!l.porEmp.length) { %>—<% } %>
                <% l.porEmp.forEach(function(e){ %><span style="display:block;white-space:nowrap"><%= e.nome %>: <b><%= e.leads %></b></span><% }); %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
      <div class="panel-foot"><p class="hint">
        <b>Leads</b> conta pessoas, não cliques: quem aperta vários botões da mesma página conta uma vez só.
        <b>Recepção</b> são os leads de qualquer canal que a recepção encaminhou ao corretor pelo WhatsApp. Abaixo do número: quantos o corretor confirmou pelo link “Recebi” e o tempo médio até confirmar.
        <b>“Não retornou”</b> conta os leads que voltaram à página depois de 24h e foram repassados a outro corretor.
        É um sinal de que o atendimento pode ter falhado, não uma prova. Vale olhar a tendência ao longo das semanas.
        Nos leads das páginas o site não recebe nome nem telefone do cliente (eles ficam no WhatsApp do corretor); nos da recepção, sim.
      </p></div>
    </div>

    <% if (sdr) { %>
    <div class="panel">
      <h2 class="panel-h">SDR · <%= rotulo.toLowerCase() %>
        <span class="sub" style="margin-left:auto;font-weight:500;font-size:12px">ligações para a lista de clientes e o que virou na sua equipe</span></h2>
      <div class="sd-retornos sd-ret-g">
        <div><b><%= sdr.ligacoes %></b><span>ligações · <%= sdr.atendidas %> atenderam</span></div>
        <div><b><%= sdr.qualificados %></b><span>qualificados (<%= sdr.atendidas ? Math.round(sdr.qualificados * 100 / sdr.atendidas) : 0 %>% dos que atenderam)</span></div>
        <div><b><%= sdr.tempoMedio %></b><span>tempo médio por ligação</span></div>
        <div><b><%= sdr.equipe.enviados %></b><span>leads para a sua equipe</span></div>
        <div><b><%= sdr.equipe.visitas %></b><span>viraram visita<%= sdr.equipe.porRetorno.fechou ? ' · ' + sdr.equipe.porRetorno.fechou + ' fecharam' : '' %></span></div>
        <div><b><%= sdr.equipe.enviados - sdr.equipe.comRetorno %></b><span>sem retorno do corretor</span></div>
      </div>
    </div>
    <% } %>

    <div class="panel">
      <h2 class="panel-h">Leads encaminhados (recepção e SDR) · <%= rotulo.toLowerCase() %></h2>
      <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Quando</th><th>Cliente</th><th>Interesse</th><th>Origem</th><th>Corretor</th><th>Recebimento</th></tr></thead>
        <tbody>
          <% if (!daRecepcao.length) { %><tr><td colspan="6" class="empty">Nenhum lead encaminhado pela recepção no período.</td></tr><% } %>
          <% daRecepcao.forEach(function(r){ %>
            <tr>
              <td class="sub"><%= fmt(r.created_at) %></td>
              <td><b><%= r.lead_nome || '—' %></b><span class="sub mono"><% if (r.lead_telefone) { %><a href="https://wa.me/<%= r.lead_telefone %>" target="_blank" rel="noopener"><%= r.lead_telefone.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3') %></a><% } %></span><% if (r.lead_email) { %><span class="sub"><%= r.lead_email %></span><% } %></td>
              <td class="sub"><%= [r.negocio, r.imovel ? 'imóvel ' + r.imovel : ''].filter(Boolean).join(' · ') || '—' %><% if (r.mensagem) { %><span class="rc-msg" title="<%= r.mensagem %>"><%= r.mensagem %></span><% } %></td>
              <td class="sub"><%= [r.origem, r.canal].filter(Boolean).filter(function(v, i, a){ return a.indexOf(v) === i; }).join(' · ') || '—' %></td>
              <td><%= r.corretor %></td>
              <td class="sub">
                <% if (r.confirmado_em) { %><span style="color:#0d7a3f;font-weight:650">✓ confirmou</span><span class="sub">em <%= duracao((new Date(r.confirmado_em) - new Date(r.created_at)) / 60000) %></span><% if (r.retorno) { %><span class="sub" style="color:#0d7a3f;font-weight:650"><%= RETORNOS[r.retorno] %></span><% } %>
                <% } else if (r.substituido_por) { %><span style="color:var(--danger);font-weight:650">não confirmou</span><span class="sub">reencaminhado a outro corretor</span>
                <% } else if (r.token) { var esp = (Date.now() - new Date(r.created_at)) / 60000; %><span style="<%= esp > 60 ? 'color:var(--danger);font-weight:650' : '' %>">sem confirmar</span><span class="sub">há <%= duracao(esp) %></span>
                <% } else { %>—<% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>

    <div class="split">
      <div class="panel">
        <h2 class="panel-h">Últimos leads das páginas (site)</h2>
        <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Quando</th><th>Cliente</th><th>Corretor</th><th>Empreendimento</th><th>Campanha</th></tr></thead>
          <tbody>
            <% if (!recentes.length) { %><tr><td colspan="5" class="empty">Nenhum lead no período.</td></tr><% } %>
            <% recentes.forEach(function(r){ %>
              <tr>
                <td class="sub"><%= fmt(r.created_at) %></td>
                <td><% if (r.lead_telefone) { %><b><%= r.lead_nome %></b><span class="sub mono"><a href="https://wa.me/<%= r.lead_telefone %>" target="_blank" rel="noopener"><%= r.lead_telefone.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3') %></a></span><% if (r.interesse) { %><span class="sub"><%= r.interesse %></span><% } %><% } else { %><span class="sub">sem formulário</span><% } %></td>
                <td><%= r.corretor %><% if (r.resgate) { %><span class="tag">resgate</span><% } %><% if (r.protocolo) { %><span class="sub mono"><%= r.protocolo %></span><% } %></td>
                <td class="sub"><%= r.emp %></td>
                <td class="sub"><%= [r.utm_source, r.utm_campaign].filter(Boolean).join(' · ') || '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>

      <div class="panel">
        <h2 class="panel-h">Por empreendimento</h2>
        <div class="tbl-wrap">
        <table class="tbl">
          <tbody>
            <% if (!porEmp.length) { %><tr><td class="empty">Nenhum lead no período.</td></tr><% } %>
            <% porEmp.forEach(function(e){ %>
              <tr>
                <td>
                  <b><%= e.nome %></b>
                  <div class="bar" style="margin-top:6px"><span style="width:<%= maxEmp ? (e.leads * 100 / maxEmp).toFixed(1) : 0 %>%"></span></div>
                </td>
                <td class="num big" style="text-align:right"><%= e.leads %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
