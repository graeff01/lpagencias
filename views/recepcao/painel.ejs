<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
  <%
    var fmt = function(d){ return new Date(d).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }); };
    var iniciais = function(n){ return String(n).replace(/[^A-Za-zÀ-ÿ\s]/g, '').trim().split(/\s+/).slice(0, 2).map(function(p){ return p[0]; }).join('').toUpperCase(); };
  %>
  <header class="topbar">
    <a class="brand" href="/recepcao"><span class="m"><svg viewBox="0 0 24 24" fill="none"><path d="M4 11L12 4l8 7v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1v-8Z" fill="#fff"/></svg></span><span>Auxiliadora<small>Recepção · <%= usuario.nome %></small></span></a>
    <div class="sp"></div>
    <div class="top-links">
      <form method="POST" action="/recepcao/logout"><button class="btn btn-ghost btn-sm" type="submit">Sair</button></form>
    </div>
  </header>

  <div class="wrap rc-wrap">
    <div class="page-head">
      <div>
        <div class="eyebrow">Encaminhar lead · <b id="rc-hoje"><%= deHoje %></b> hoje</div>
        <h1>Novo lead</h1>
        <p>Cole a mensagem que chegou, confira os dados e toque no corretor. O WhatsApp abre com o lead organizado, é só enviar.</p>
      </div>
    </div>

    <div class="panel rc-lead">
      <h2 class="panel-h"><span class="rc-n">1</span> Cole a mensagem do lead</h2>
      <div class="frm">
        <textarea id="rc-cola" rows="4" placeholder="Copie a mensagem inteira no WhatsApp e cole aqui"></textarea>
        <div class="rc-acoes">
          <button type="button" class="btn btn-green btn-sm" id="rc-colar" hidden>Colar do WhatsApp</button>
          <span class="rc-lido" id="rc-lido"></span>
          <button type="button" class="btn btn-ghost btn-sm" id="rc-limpar" style="margin-left:auto">Limpar</button>
        </div>
      </div>
    </div>

    <div class="panel rc-lead">
      <h2 class="panel-h"><span class="rc-n">2</span> Confira os dados</h2>
      <form class="frm rc-campos" id="rc-form" autocomplete="off" onsubmit="return false">
        <div class="fg"><label>Nome do cliente <i class="rc-req">*</i></label><input name="nome" placeholder="Ex.: Thailher Ghedini"></div>
        <div class="fg"><label>Telefone <i class="rc-req">*</i></label><input name="telefone" inputmode="tel" placeholder="(51) 99999-0000"><span class="rc-aviso" id="rc-dono" hidden></span></div>
        <div class="fg"><label>E-mail</label><input name="email" inputmode="email"></div>
        <div class="fg2">
          <div class="fg"><label>Negócio</label>
            <select name="negocio" class="sel rc-sel"><option value="">—</option><option>Venda</option><option>Locação</option></select>
          </div>
          <div class="fg"><label>Imóvel / código</label><input name="imovel" placeholder="Ex.: 817210"></div>
        </div>
        <div class="fg"><label>Origem</label><input name="origem" placeholder="Ex.: ZAP Imóveis, indicação do Pedro"></div>
        <div class="fg">
          <label>Canal</label>
          <div class="chips" id="rc-canais">
            <% canais.forEach(function(c){ %><button type="button" class="chip" data-canal="<%= c %>"><%= c %></button><% }); %>
          </div>
        </div>
        <div class="fg" style="margin-bottom:0"><label>Mensagem do cliente</label><textarea name="mensagem" rows="3"></textarea></div>
      </form>
    </div>

    <div class="panel rc-lead" style="overflow:visible">
      <h2 class="panel-h"><span class="rc-n">3</span> Toque no corretor
        <span class="rc-modo" id="rc-modo" title="Onde o WhatsApp abre">
          <button type="button" data-modo="web">WhatsApp Web</button><button type="button" data-modo="app">Aplicativo</button>
        </span>
      </h2>
      <div class="frm" style="padding-bottom:6px">
        <% if (campanhas.length) { %>
          <div class="rc-abas" id="rc-abas">
            <button type="button" data-aba="geral" class="on">Lista geral</button>
            <% campanhas.forEach(function(c){ %><button type="button" data-aba="c<%= c.id %>">Campanha <%= c.nome %></button><% }); %>
          </div>
        <% } %>
        <div data-painel="geral">
          <div class="rc-sugerido" id="rc-sugerido" hidden></div>
          <div class="rc-busca"><input id="rc-busca" type="search" placeholder="Buscar corretor pelo nome" autocomplete="off"></div>
        </div>
      </div>
      <% campanhas.forEach(function(c){ %>
        <div class="rc-camp" data-painel="c<%= c.id %>" data-camp="<%= c.id %>" hidden></div>
      <% }); %>
      <div class="rc-lista" id="rc-lista" data-painel="geral">
        <% if (!corretores.length) { %>
          <div class="warn-box" style="grid-column:1/-1">Nenhum corretor cadastrado ainda. O administrador cadastra em <b>Painel → Recepção</b>.</div>
        <% } %>
        <% var temGerente = corretores.some(function(c){ return c.destaque; }); %>
        <% corretores.forEach(function(c, i){ %>
          <% if (temGerente && i === 0) { %><div class="rc-grupo" data-grupo="g">Gerentes</div><% } %>
          <% if (temGerente && !c.destaque && (i === 0 || corretores[i-1].destaque)) { %><div class="rc-grupo" data-grupo="c">Corretores</div><% } %>
          <a class="rc-item<%= c.destaque ? ' rc-gerente' : '' %>" href="https://wa.me/<%= c.telefone %>" target="_blank" rel="noopener"
             data-id="<%= c.id %>" data-nome="<%= c.nome %>" data-fone="<%= c.telefone %>" data-grupo="<%= c.destaque ? 'g' : 'c' %>">
            <span class="rc-av"><%= iniciais(c.nome) %></span>
            <span class="rc-nm"><%= c.nome %></span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        <% }); %>
      </div>
    </div>

    <div class="panel" style="margin-top:22px">
      <h2 class="panel-h">Seus últimos envios</h2>
      <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Quando</th><th>Cliente</th><th>Corretor</th></tr></thead>
        <tbody id="rc-recentes">
          <% if (!recentes.length) { %><tr class="rc-vazio"><td colspan="3" class="empty">Nenhum envio ainda.</td></tr><% } %>
          <% recentes.forEach(function(r){ %>
            <tr><td class="sub"><%= fmt(r.created_at) %></td><td><%= r.lead_nome || '—' %><span class="sub mono"><%= r.lead_telefone ? r.lead_telefone.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3') : '' %></span></td><td><%= r.corretor_nome %></td></tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <div class="rc-toast" id="rc-toast" role="status" aria-live="polite"></div>

  <script>window.RC_CAMPANHAS = <%- JSON.stringify(campanhas).replace(/</g, '\\u003c') %>;</script>
  <script src="/js/lead-parser.js?v=<%= v %>"></script>
  <script>
    (function () {
      var P = window.LeadParser;
      var cola = document.getElementById('rc-cola');
      var form = document.getElementById('rc-form'), el = form.elements;
      var lido = document.getElementById('rc-lido');
      var dono = document.getElementById('rc-dono');
      var canal = '';

      // Onde o WhatsApp abre. No computador, o WhatsApp Web sempre na mesma
      // aba (a janela "rc-whatsapp" é reaproveitada a cada envio); no
      // celular, o aplicativo. A escolha fica salva neste navegador.
      var celular = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
      var modo = celular ? 'app' : 'web';
      try { modo = localStorage.getItem('rc-whats') || modo; } catch (e) {}
      function marcarModo(m) {
        modo = m;
        try { localStorage.setItem('rc-whats', m); } catch (e) {}
        document.querySelectorAll('#rc-modo button').forEach(function (b) { b.classList.toggle('on', b.dataset.modo === m); });
      }
      marcarModo(modo);
      document.getElementById('rc-modo').addEventListener('click', function (e) {
        var b = e.target.closest('[data-modo]');
        if (b) marcarModo(b.dataset.modo);
      });
      function linkWhats(fone, texto) {
        return modo === 'web'
          ? 'https://web.whatsapp.com/send?phone=' + fone + '&text=' + encodeURIComponent(texto)
          : 'https://wa.me/' + fone + '?text=' + encodeURIComponent(texto);
      }

      // "Corretor responsável" escrito na mensagem (e-mails do portal):
      // destaca na lista quem tem esse nome. Só sugere; quem decide é ela.
      var sugerido = document.getElementById('rc-sugerido');
      function normNome(n) { return String(n || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z\s]/g, ' ').split(/\s+/).filter(function (p) { return p.length > 2; }); }
      function destacarResponsavel(nome) {
        var alvo = normNome(nome), achado = null;
        document.querySelectorAll('.rc-item').forEach(function (a) {
          var n = normNome(a.dataset.nome);
          var bate = alvo.length && n.length && n[0] === alvo[0] && (alvo.length < 2 || n.indexOf(alvo[alvo.length - 1]) >= 0 || n.length === 1);
          a.classList.toggle('rc-resp', !!bate && !achado);
          if (bate && !achado) achado = a;
        });
        if (achado) {
          sugerido.textContent = 'A mensagem indica como corretor responsável: ' + achado.dataset.nome + ' (destacado abaixo).';
          sugerido.hidden = false;
        } else if (alvo.length && /[a-z]/i.test(nome) && !/ - /.test(nome)) {
          sugerido.textContent = 'A mensagem indica como corretor responsável: ' + nome + ' (não está na lista).';
          sugerido.hidden = false;
        } else {
          sugerido.hidden = true;
        }
      }

      function marcarCanal(c) {
        canal = c || '';
        document.querySelectorAll('#rc-canais .chip').forEach(function (x) { x.classList.toggle('on', x.dataset.canal === canal); });
      }
      document.getElementById('rc-canais').addEventListener('click', function (e) {
        var b = e.target.closest('[data-canal]');
        if (b) marcarCanal(b.dataset.canal === canal ? '' : b.dataset.canal);
      });

      // Colou a mensagem: o sistema separa os campos sozinho.
      function preencher() {
        var d = P.ler(cola.value);
        ['nome', 'email', 'negocio', 'imovel', 'origem', 'mensagem'].forEach(function (k) { el[k].value = d[k] || ''; });
        el.telefone.value = d.telefone ? P.formatarFone(d.telefone) : '';
        marcarCanal(P.canalDaOrigem(d.origem));
        destacarResponsavel(d.corretor);
        var achou = ['nome', 'telefone', 'email', 'imovel'].filter(function (k) { return d[k]; }).length;
        lido.textContent = cola.value.trim() ? (achou ? '✓ Dados separados. Confira abaixo.' : 'Não reconheci os campos: preencha abaixo.') : '';
        verificarDono();
      }
      cola.addEventListener('input', preencher);

      // Botão de colar em um toque, onde o navegador permite.
      var btnColar = document.getElementById('rc-colar');
      if (navigator.clipboard && navigator.clipboard.readText) {
        btnColar.hidden = false;
        btnColar.addEventListener('click', function () {
          navigator.clipboard.readText().then(function (t) { cola.value = t; preencher(); })
            .catch(function () { cola.focus(); avisar('Toque e segure na caixa e escolha Colar.'); });
        });
      }

      // Aviso (não bloqueia) se este cliente já foi encaminhado antes.
      var tDono;
      function verificarDono() {
        clearTimeout(tDono);
        dono.hidden = true;
        var f = P.normalizarFone(el.telefone.value);
        if (!f) return;
        tDono = setTimeout(function () {
          fetch('/recepcao/lead?tel=' + f, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
            if (!j.ok || !j.ultimo) return;
            var q = new Date(j.ultimo.quando).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' });
            dono.textContent = 'Este cliente já foi enviado para ' + j.ultimo.corretor + ' em ' + q + '.';
            dono.hidden = false;
          }).catch(function () {});
        }, 350);
      }
      el.telefone.addEventListener('input', verificarDono);

      function limpar() {
        cola.value = ''; form.reset(); marcarCanal(''); lido.textContent = ''; dono.hidden = true;
        destacarResponsavel('');
      }
      document.getElementById('rc-limpar').addEventListener('click', limpar);

      document.getElementById('rc-busca').addEventListener('input', function () {
        var t = this.value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
        document.querySelectorAll('.rc-item').forEach(function (a) {
          var n = a.dataset.nome.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
          a.hidden = t && n.indexOf(t) < 0;
        });
        // Título do grupo some quando a busca não deixa ninguém nele.
        document.querySelectorAll('.rc-grupo').forEach(function (g) {
          g.hidden = !document.querySelector('.rc-item[data-grupo="' + g.dataset.grupo + '"]:not([hidden])');
        });
      });

      var toast = document.getElementById('rc-toast'), tt;
      function avisar(txt) {
        toast.textContent = txt; toast.classList.add('on');
        clearTimeout(tt); tt = setTimeout(function () { toast.classList.remove('on'); }, 3500);
      }

      // O link é montado na hora do clique, e o envio é registrado em
      // paralelo: se o registro falhar, o WhatsApp abre igual.
      // ---- Campanhas: roleta de um empreendimento dentro da recepção ----
      var horaCurta = function (d) { return d ? new Date(d).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : ''; };
      function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
      function renderCampanha(c) {
        var box = document.querySelector('.rc-camp[data-camp="' + c.id + '"]');
        if (!box) return;
        var prox = c.fila[0];
        var h = '<p class="rc-camp-txt">Roleta da campanha <b>' + esc(c.nome) + '</b>: os leads vão em rodízio entre os corretores abaixo. '
          + 'Envie sempre para o <b>próximo da vez</b>. Os leads que chegam pela página do ' + esc(c.nome) + ' também entram nesta fila.</p>';
        if (!prox) {
          h += '<div class="warn-box">Nenhum corretor ativo nesta roleta. O administrador ajusta em Painel → Corretores do ' + esc(c.nome) + '.</div>';
        } else {
          h += '<div class="rc-prox-lbl">Próximo da vez</div>'
            + '<a class="rc-item rc-prox" href="https://wa.me/' + prox.telefone + '" target="_blank" rel="noopener" data-id="' + prox.id + '" data-nome="' + esc(prox.nome) + '" data-fone="' + prox.telefone + '" data-camp="' + c.id + '">'
            + '<span class="rc-av">' + esc(prox.nome.replace(/[^A-Za-zÀ-ÿ\s]/g, '').trim().split(/\s+/).slice(0, 2).map(function (p) { return p[0]; }).join('').toUpperCase()) + '</span>'
            + '<span class="rc-nm">Enviar para ' + esc(prox.nome) + '</span>'
            + '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>';
          h += '<div class="rc-fila"><div class="rc-prox-lbl">Fila</div><ol>' + c.fila.map(function (f, i) {
            return '<li class="' + (i === 0 ? 'vez' : '') + '"><span>' + esc(f.nome) + '</span><small>'
              + (i === 0 ? 'é a vez' : f.ultima ? '✓ recebeu ' + horaCurta(f.ultima) : 'ainda não recebeu') + ' · ' + f.atribuicoes + (f.atribuicoes === 1 ? ' lead' : ' leads') + '</small></li>';
          }).join('') + '</ol></div>';
        }
        if (c.envios.length) {
          h += '<div class="rc-prox-lbl" style="margin-top:14px">Seus envios nesta campanha</div><ul class="rc-envios">' + c.envios.slice(0, 10).map(function (e) {
            return '<li>✓ <b>' + esc(e.corretor) + '</b> · ' + esc(e.cliente || '') + ' <small>' + horaCurta(e.quando) + '</small></li>';
          }).join('') + '</ul>';
        }
        box.innerHTML = h;
      }
      (window.RC_CAMPANHAS || []).forEach(renderCampanha);
      // A fila também anda com leads do site: atualiza a cada 20 s.
      setInterval(function () {
        (window.RC_CAMPANHAS || []).forEach(function (c) {
          fetch('/recepcao/campanha/' + c.id, { credentials: 'same-origin' }).then(function (r) { return r.json(); })
            .then(function (j) { if (j.ok) renderCampanha(j.campanha); }).catch(function () {});
        });
      }, 20000);

      var abas = document.getElementById('rc-abas');
      function mostrarAba(id) {
        if (!document.querySelector('[data-painel="' + id + '"]')) id = 'geral';
        document.querySelectorAll('[data-painel]').forEach(function (p) { p.hidden = p.dataset.painel !== id; });
        if (abas) abas.querySelectorAll('button').forEach(function (b) { b.classList.toggle('on', b.dataset.aba === id); });
        try { localStorage.setItem('rc-aba', id); } catch (e) {}
      }
      if (abas) {
        abas.addEventListener('click', function (e) { var b = e.target.closest('[data-aba]'); if (b) mostrarAba(b.dataset.aba); });
        var abaSalva = 'geral'; try { abaSalva = localStorage.getItem('rc-aba') || 'geral'; } catch (e) {}
        mostrarAba(abaSalva);
      }

      document.querySelector('.rc-wrap').addEventListener('click', function (e) {
        var a = e.target.closest('.rc-item');
        if (!a) return;
        var d = {
          nome: el.nome.value.trim(), telefone: P.normalizarFone(el.telefone.value), email: el.email.value.trim(),
          negocio: el.negocio.value, imovel: el.imovel.value.trim(), origem: el.origem.value.trim(),
          mensagem: el.mensagem.value.trim(), canal: canal,
        };
        if (!d.nome || !d.telefone) {
          e.preventDefault();
          avisar(!d.nome ? 'Falta o nome do cliente.' : 'Falta um telefone válido do cliente.');
          (d.nome ? el.telefone : el.nome).focus();
          return;
        }
        a.href = linkWhats(a.dataset.fone, P.mensagemCorretor(d));
        // Aba nomeada: o mesmo WhatsApp Web é reaproveitado a cada envio.
        a.target = modo === 'web' ? 'rc-whatsapp' : '_blank';
        a.rel = modo === 'web' ? '' : 'noopener';

        var corpo = Object.assign({ corretor_id: a.dataset.id }, d);
        var camp = a.dataset.camp;
        fetch(camp ? '/recepcao/campanha/' + camp + '/enviar' : '/recepcao/enviar', {
          method: 'POST', keepalive: true, credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo),
        }).then(function (r) {
          if (!r.ok) { avisar('O WhatsApp abriu, mas o envio não foi registrado. Recarregue a página.'); return null; }
          return r.json();
        }).then(function (j) { if (j && j.campanha) renderCampanha(j.campanha); })
          .catch(function () {});

        var tb = document.getElementById('rc-recentes');
        var vazio = tb.querySelector('.rc-vazio'); if (vazio) vazio.remove();
        var tr = document.createElement('tr');
        var agora = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
        [agora, d.nome, a.dataset.nome].forEach(function (v, i) {
          var td = document.createElement('td'); td.textContent = v; if (!i) td.className = 'sub'; tr.appendChild(td);
        });
        tb.insertBefore(tr, tb.firstChild);
        var h = document.getElementById('rc-hoje'); h.textContent = Number(h.textContent) + 1;

        avisar('Lead de ' + d.nome + ' enviado para ' + a.dataset.nome + '.');
        limpar();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</body>
</html>
