      <div class="hub" aria-live="polite"><div class="hub-in"><span class="hub-ic"></span><b class="hub-t"></b><span class="hub-s"></span></div></div>
      <% aneis.forEach(function(anel, a){ %>
        <div class="anel a<%= a + 1 %>">
          <% anel.forEach(function(it, k){ var idx = a === 0 ? k : nExt + k; %>
            <button type="button" class="bolha cor-<%= it.cor %>" style="--a:<%= (360 / anel.length * k).toFixed(2) %>deg" data-i="<%= idx %>" data-t="<%= it.t %>" data-s="<%= it.sub %>" aria-label="<%= it.t %>"><span><%- it.svg %></span></button>
