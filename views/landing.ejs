<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <script>
    // Animações de entrada só valem com o JS rodando. Se o script principal
    // não confirmar em 4 s (erro, navegador embutido, celular travado),
    // tudo aparece sem animação: nunca seção em branco.
    document.documentElement.classList.add('js');
    setTimeout(function(){ if(!window.__animOk) document.documentElement.classList.remove('js'); },4000);
  </script>
  <title><%= title %></title>
  <% if (e.meta_description) { %><meta name="description" content="<%= e.meta_description %>"><% } %>
  <meta property="og:title" content="<%= e.nome %>">
  <% if (e.meta_description) { %><meta property="og:description" content="<%= e.meta_description %>"><% } %>
  <% if (e.hero_image) { %>
  <meta property="og:image" content="<%= canonical.replace(/\/[^\/]*$/, '') + e.hero_image %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="<%= e.nome %><%= e.bairro ? ' — ' + e.bairro : '' %>">
  <% } %>
  <meta property="og:site_name" content="Auxiliadora Predial">
  <meta property="og:locale" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= e.nome %>">
  <% if (e.meta_description) { %><meta name="twitter:description" content="<%= e.meta_description %>"><% } %>
  <% if (e.hero_image) { %><meta name="twitter:image" content="<%= canonical.replace(/\/[^\/]*$/, '') + e.hero_image %>"><% } %>
  <meta name="theme-color" content="<%= e._green %>">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <% var heroV = h.imgVar(e.hero_image); %>
  <% if (heroV.src) { %>
  <link rel="preload" as="image" href="<%= heroV.src %>" fetchpriority="high"<% if (heroV.sm) { %> media="(min-width:761px)"<% } %>>
  <% if (heroV.sm) { %><link rel="preload" as="image" href="<%= heroV.sm %>" fetchpriority="high" media="(max-width:760px)"><% } %>
  <% } %>
  <link rel="canonical" href="<%= canonical %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://res.cloudinary.com" crossorigin>
  <link rel="stylesheet" href="/css/landing.css?v=<%= v %>">
  <link rel="stylesheet" href="/css/flutuantes.css?v=<%= v %>">
  <% if (outros && outros.length) { %><link rel="stylesheet" href="/css/vitrine.css?v=<%= v %>"><% } %>
  <style>
    :root{
      --green:<%= e._green %>; --green-deep:<%= e._greenDeep %>;
      --green-bright:<%= e._greenBright %>; --green-ink:<%= e._greenInk %>;
      --orange:<%= e._accent %>; --orange-deep:<%= e._accentDeep %>;
    }
    .hero .bg{background-image:linear-gradient(105deg,rgba(6,20,12,.92) 0%,rgba(6,20,12,.55) 42%,rgba(6,20,12,.2) 100%)<% if (heroV.src) { %>,url("<%= heroV.src %>")<% } else { %>,linear-gradient(60deg,var(--green-deep),var(--green-bright))<% } %>;}
    <% if (heroV.sm) { %>@media(max-width:760px){.hero .bg{background-image:linear-gradient(105deg,rgba(6,20,12,.92) 0%,rgba(6,20,12,.55) 42%,rgba(6,20,12,.2) 100%),url("<%= heroV.sm %>")}}<% } %>
  </style>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context":"https://schema.org",
    "@type":"Residence",
    "name": e.nome,
    "url": canonical,
    "description": e.meta_description || e.descricao || undefined,
    "image": e.hero_image ? canonical.replace(/\/[^\/]*$/, '') + e.hero_image : undefined,
    "address": {
      "@type":"PostalAddress",
      "streetAddress": e.endereco || undefined,
      "addressLocality": e.cidade || undefined,
      "addressRegion":"RS",
      "addressCountry":"BR"
    },
    "numberOfRooms": e.dormitorios || undefined,
    "floorSize": e.area ? { "@type":"QuantitativeValue", "value": e.area, "unitCode":"MTK" } : undefined,
    "offers": e.preco_inicial ? {
      "@type":"Offer",
      "price": e.preco_inicial,
      "priceCurrency":"BRL",
      "availability":"https://schema.org/InStock",
      "seller": { "@type":"RealEstateAgent", "name":"Auxiliadora Predial" }
    } : undefined
  }, function(k,v){ return v === undefined ? undefined : v; }) %>
  </script>
  <% if (e.faq && e.faq.length) { %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context":"https://schema.org",
    "@type":"FAQPage",
    "mainEntity": e.faq.map(function(f){ return {
      "@type":"Question",
      "name": f.q,
      "acceptedAnswer": { "@type":"Answer", "text": f.a }
    }; })
  }) %>
  </script>
  <% } %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context":"https://schema.org",
    "@type":"BreadcrumbList",
    "itemListElement":[
      {"@type":"ListItem","position":1,"name":"Empreendimentos","item": canonical.replace(/\/[^\/]*$/, '/')},
      {"@type":"ListItem","position":2,"name": e.nome,"item": canonical}
    ]
  }) %>
  </script>
  <% if (e.ga_id || e.ads_conversao) { %>
  <% var tagPrincipal = e.ga_id || (e.ads_conversao||'').split('/')[0]; %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= tagPrincipal %>"></script>
  <script>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());
    <% if (e.ga_id) { %>gtag('config','<%= e.ga_id %>');<% } %>
    <% if (e.ads_conversao) { %>gtag('config','<%= e.ads_conversao.split('/')[0] %>');<% } %>
  </script>
  <% } %>
  <% if (e.pixel_id) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= e.pixel_id %>');fbq('track','PageView');</script>
  <noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=<%= e.pixel_id %>&ev=PageView&noscript=1"/></noscript>
  <% } %>
</head>
<body>
<%
  var wave='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 16c2 0 2 1.5 4 1.5S8 16 10 16s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5M6 12l6-4 6 4"/></svg>';
  var infraIcons=[
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M2 16c2 0 2 1.5 4 1.5S8 16 10 16s2 1.5 4 1.5 2-1.5 4-1.5 2 1.5 4 1.5M6 12l6-4 6 4M9 10V6h6v4"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 7v10M18 7v10M3 10h3M18 10h3M6 12h12"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M7 20h10M12 16v4"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M10 5.5a2.5 2.5 0 1 1 4 0M7 12a5 5 0 0 1 10 0v6H7v-6ZM5 18h14"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l2.5 5 5.5.8-4 3.9 1 5.5L12 21l-5-2.8 1-5.5-4-3.9L9.5 8 12 3Z"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 12a8 8 0 0 1 16 0M12 12v8M8 20h8"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2v6M5 8l3 3M19 8l-3 3M4 14h16l-1 7H5l-1-7Z"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 15h4"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM7 15V6l10-2v9M17 13a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12l2-2 4 4 6-6 2 2M5 20h14"/></svg>',
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 10h16M6 10V6a6 6 0 0 1 12 0v4M8 14h8M8 18h5"/></svg>'
  ];
  var planDraws=[
    '<svg viewBox="0 0 120 90" fill="none" stroke="var(--green)" stroke-width="1.5"><rect x="8" y="8" width="104" height="74" rx="2" stroke-opacity=".3"/><path d="M8 40h44M52 8v74M52 46h30M82 46v36M70 8v20M70 28H52"/><circle cx="30" cy="24" r="6" stroke-opacity=".5"/><rect x="88" y="14" width="18" height="10" stroke-opacity=".5"/></svg>',
    '<svg viewBox="0 0 120 90" fill="none" stroke="var(--green)" stroke-width="1.5"><rect x="8" y="8" width="104" height="74" rx="2" stroke-opacity=".3"/><path d="M60 8v74M8 44h52M60 40h52M8 24h30M38 8v16M82 40V82M82 60h30"/><circle cx="24" cy="60" r="7" stroke-opacity=".5"/><rect x="14" y="14" width="16" height="9" stroke-opacity=".5"/></svg>',
    '<svg viewBox="0 0 120 90" fill="none" stroke="var(--green)" stroke-width="1.5"><rect x="8" y="8" width="104" height="74" rx="2" stroke-opacity=".3"/><path d="M8 46h48M56 8v74M56 44h56M40 8v22M40 30H8M84 44v38M84 62h28M8 62h20"/><circle cx="26" cy="26" r="7" stroke-opacity=".5"/><rect x="92" y="14" width="16" height="10" stroke-opacity=".5"/></svg>'
  ];
  var icoBed='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 14h18M6 10V7h12v3"/></svg>';
  var icoBath='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 4 0"/></svg>';
  var icoCar='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="7" rx="1"/><path d="M5 11V8h14v3"/></svg>';
  var icoCheck='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>';
  var icoPin='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>';
  var waSvg='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.6-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2 0 .4-.1.5l-.4.5c-.2.2-.3.3-.1.6.2.4.9 1.4 1.9 2.2 1.2 1.1 2.2 1.4 2.5 1.5.2.1.4.1.6-.1l.7-.9c.2-.3.4-.2.6-.1l1.9.9c.3.1.4.2.5.3.1.3.1.9-.1 1.5Z"/></svg>';
  var logoSvg='<svg viewBox="0 0 24 24" fill="none"><path d="M4 11L12 4l8 7v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1v-8Z" fill="#fff"/></svg>';
  var gal=e.gallery||[];
%>

<nav class="nav" id="nav">
  <a class="nav-back" href="<%= portalBase %>/" data-vt-link>
    <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></span>
    <span class="tx"><small>Voltar para</small><b><span class="lg">Todos os lançamentos</span><span class="sm">Lançamentos</span></b></span>
  </a>
  <div class="nav-nome" aria-hidden="true"><%= e.nome %></div>
  <a class="nav-cta" href="#contato"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg><span class="lg">Agendar visita</span><span class="sm">Agendar</span></a>
</nav>

<% if (isPreview) { %><div class="ribbon"><span class="d"></span>Pré-visualização · rascunho não publicado</div><% } %>

<header class="hero">
  <div class="bg"></div>
  <div class="hero-inner">
    <div class="hero-grid">
      <div>
        <% var selo = [e.status, e.construtora].filter(Boolean).join(' · '); %><% if (selo) { %><span class="badge"><span class="d"></span><%= selo %></span><% } %>
        <h1><%= e.nome %></h1>
        <% var subBusca = h.subtituloBusca(e); %>
        <% if (subBusca) { %><p class="sub-h1"><%= subBusca %></p><% } %>
        <div class="loc"><%- icoPin %><%= [e.endereco, e.bairro, e.cidade].filter(Boolean).join(' · ') %></div>
        <div class="cta-row">
          <a href="#contato" class="btn primary"><%= e.cta || 'Quero conhecer' %> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a href="<%= wa %>?src=hero" target="_blank" rel="noopener nofollow" class="btn wa"><%- waSvg %>Falar no WhatsApp</a>
        </div>
      </div>
      <div class="hero-card">
        <div class="hc-preco"><span class="pl"><%= e._precoFmt ? h.tipoImovel(e) + ' a partir de' : 'Valores e condições' %></span><span class="pv"><%= e._precoFmt || 'Sob consulta' %></span></div>
        <div class="g4">
          <div class="st"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 19v-7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v7M2 15h20M5 10V7.5A1.5 1.5 0 0 1 6.5 6h4A1.5 1.5 0 0 1 12 7.5V10M12 10V7.5A1.5 1.5 0 0 1 13.5 6h4A1.5 1.5 0 0 1 19 7.5V10"/></svg></span><b><%= e.dormitorios ? h.dormsTexto(e.dormitorios).replace(/ dorm\.$/, '') : '—' %></b><span>Dormitórios</span></div>
          <div class="st"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h7M3 3v7M21 21h-7M21 21v-7M3 3l7 7M21 21l-7-7"/><rect x="8" y="8" width="8" height="8" rx="1"/></svg></span><b><%= e.area ? e.area + ' m²' : 'Consulte' %></b><span>Área privativa</span></div>
          <div class="st"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 16V11l2-5h10l2 5v5M3 16h18v3H3zM6 19v2M18 19v2"/><circle cx="7.5" cy="13" r=".8" fill="currentColor"/><circle cx="16.5" cy="13" r=".8" fill="currentColor"/></svg></span><b><%= e.vagas || '—' %></b><span>Vagas</span></div>
          <div class="st"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M15 8l2 2"/></svg></span><b><%= e.entrega || 'Consulte' %></b><span>Entrega</span></div>
        </div>
      </div>
    </div>
  </div>
  <div class="scroll-cue"><div class="m"></div>Explore</div>
</header>

<% if (e.construtora_stats && e.construtora_stats.length) { %>
<div class="trust">
  <div class="wrap"><div class="row">
    <% [0, 1].forEach(function(copia){ e.construtora_stats.forEach(function(s){ %>
      <div class="it<%= copia ? ' dup' : '' %>"<%- copia ? ' aria-hidden="true"' : '' %>><span class="ic"><%- icoCheck %></span><div><b><%= s.num %></b> <%= s.label %></div></div>
    <% }); }); %>
  </div></div>
</div>
<% } %>

<% if (gal.length) { %>
<section class="sec" id="galeria">
  <div class="wrap">
    <div class="sec-head rv"><div class="kick">Galeria</div><h2 class="sec-h2">Cada detalhe pensado para viver bem</h2><p class="lead">Perspectivas do empreendimento, das áreas comuns e do apartamento.</p></div>
    <div class="gal rv">
      <% gal.slice(0,5).forEach(function(g, i){ %>
        <button type="button" class="c<%= i===0 ? ' big' : '' %>" data-lb="<%= i %>" aria-label="Abrir foto <%= i+1 %> de <%= gal.length %><%= g.tag ? ': ' + g.tag : '' %>">
          <%- h.img(g.url, { alt: h.altFoto(g.tag, e), w: 800, h: 600, sizes: i===0 ? '(max-width:760px) 100vw, 60vw' : '(max-width:760px) 50vw, 25vw' }) %>
          <% if (i===4 && gal.length>5) { %>
            <div class="more"><span class="n">+<%= gal.length-5 %></span><span class="t">fotos</span></div>
          <% } else { %>
            <div class="ov"></div>
            <span class="zoom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/></svg></span>
            <% if (g.tag) { %><span class="tag"><%= g.tag %></span><% } %>
          <% } %>
        </button>
      <% }); %>
    </div>
    <% if (gal.length > 5) { %>
      <div class="gal-all rv"><button type="button" class="btn ghost-line" data-lb="0">Ver todas as <%= gal.length %> fotos</button></div>
    <% } %>
  </div>
</section>
<% } %>


<% if (e.video_url || e.tour_url) { var vposter = (gal[0] && gal[0].url) || e.hero_image; %>
<section class="sec alt" id="video">
  <div class="wrap">
    <div class="sec-head rv"><div class="kick">Vídeo &amp; Tour virtual</div><h2 class="sec-h2">Conheça de onde você estiver</h2><p class="lead">Assista ao filme do empreendimento ou faça um tour imersivo pelo apartamento decorado, sem sair de casa.</p></div>
    <a class="video rv" href="<%= e.video_url || e.tour_url %>" target="_blank" rel="noopener" style="display:block">
      <% if (vposter) { %><img src="<%= vposter %>" alt="Vídeo"/><% } %><div class="shade"></div>
      <% if (e.tour_url) { %><div class="tour"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM2 12h20M12 2c3 3 3 17 0 20M12 2c-3 3-3 17 0 20"/></svg>Tour 360°</div><% } %>
      <div class="play"><div class="pb"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8V4Z"/></svg></div></div>
      <div class="cap"><b><%= e.nome %> · O filme</b><span>Clique para assistir</span></div>
    </a>
  </div>
</section>
<% } %>

<% if (e.plantas.length) { %>
<section class="sec" id="plantas">
  <div class="wrap">
    <div class="sec-head rv"><div class="kick">Plantas</div><h2 class="sec-h2">Escolha a planta ideal para você</h2><p class="lead">Conheça as opções de planta e encontre a que combina com você.</p></div>
    <div class="plants rv" data-cf>
      <% e.plantas.forEach(function(p, i){ %>
        <div class="plant<%= p.imagem ? ' has-img' : '' %>">
          <% if (p.imagem) { %>
            <button type="button" class="draw" data-lbp="<%= i %>" aria-label="Ampliar planta <%= p.titulo %>">
              <%- h.img(p.imagem, { alt: 'Planta humanizada — ' + p.titulo + (p.area ? ', ' + p.area : ''), w: 1000, h: 850, sizes: '(max-width:760px) 80vw, 33vw' }) %>
              <% if (p.final) { %><span class="fl"><%= p.final %></span><% } %>
              <span class="zoom"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/></svg></span>
            </button>
          <% } else { %>
            <div class="draw ph">
              <% if (p.final) { %><span class="fl"><%= p.final %></span><% } %>
              <%- planDraws[i % planDraws.length] %>
              <% if (p.area) { %><span class="ar"><%= p.area %></span><% } %>
            </div>
          <% } %>
          <div class="pt">
            <div class="top"><b><%= p.titulo %></b><% if (p.area) { %><span class="area"><%= p.area %></span><% } %></div>
            <div class="specs">
              <% if (p.quartos) { %><span class="sp"><%- icoBed %><%= /\d\s*$/.test(String(p.quartos)) ? p.quartos + (String(p.quartos).trim() === '1' ? ' quarto' : ' quartos') : p.quartos %></span><% } %>
              <% if (p.banheiros) { %><span class="sp"><%- icoBath %><%= /\d\s*$/.test(String(p.banheiros)) ? p.banheiros + (String(p.banheiros).trim() === '1' ? ' banho' : ' banhos') : p.banheiros %></span><% } %>
              <% if (p.vagas) { %><span class="sp"><%- icoCar %><%= /\d\s*$/.test(String(p.vagas)) ? p.vagas + (String(p.vagas).trim() === '1' ? ' vaga' : ' vagas') : p.vagas %></span><% } %>
            </div>
