<!-- Visualizador em tela cheia (galeria e plantas) -->
<div class="lbx" id="lbx" role="dialog" aria-modal="true" aria-label="Visualizador de imagens" hidden>
  <button type="button" class="lbx-x" id="lbxX" aria-label="Fechar (Esc)">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button type="button" class="lbx-nav prev" id="lbxPrev" aria-label="Imagem anterior">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <div class="lbx-stage" id="lbxStage">
    <img id="lbxImg" alt="">
  </div>
  <button type="button" class="lbx-nav next" id="lbxNext" aria-label="Próxima imagem">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="lbx-bar"><span class="cap" id="lbxCap"></span><span class="n" id="lbxN"></span></div>
</div>

<%- include('partials/flutuantes', { wa: wa, msgBalao: ' Quer saber valores e condições do ' + e.nome + '? Fale com um consultor.' }) %>

<script>
  var WA_URL = "<%= wa %>";
  var ADS_CONV = <%- JSON.stringify(e.ads_conversao || "") %>;
  var FOTOS = <%- JSON.stringify((e.gallery||[]).map(function(g){ return { url: g.url, cap: g.tag || '' }; })) %>;
  var MAPA = <%- JSON.stringify(mapaProprio ? { lat: +parseFloat(e.lat).toFixed(6), lon: +parseFloat(e.lon).toFixed(6), nome: e.nome, pontos: pontos } : null).replace(/</g, '\\u003c') %>;
  var PLANTAS = <%- JSON.stringify((e.plantas||[]).map(function(p){ return { url: p.imagem || '', cap: [p.titulo, p.area].filter(Boolean).join(' · ') }; })) %>;
  var EMP = <%- JSON.stringify(e.nome) %>;
  var nav=document.getElementById('nav');
  addEventListener('scroll',function(){nav.classList.toggle('scrolled',scrollY>20);});
  var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:0,rootMargin:'0px 0px 140px 0px'}); window.__animOk=true;
  document.querySelectorAll('.rv').forEach(function(el){io.observe(el);});
  document.querySelectorAll('.faq .q').forEach(function(q){q.addEventListener('click',function(){q.classList.toggle('open');});});
  // ---- Campanha: as UTMs/gclid da chegada acompanham o visitante ----
  // A roleta grava utm_* de cada clique no WhatsApp; sem repassar, o
  // relatório de leads não sabe de qual campanha o lead veio. Os links para
  // outros empreendimentos também levam, para a atribuição não se perder.
  (function(){
    var CHAVES=['utm_source','utm_medium','utm_campaign','utm_term','utm_content','gclid','gbraid','wbraid','fbclid'];
    var q=new URLSearchParams(location.search), salvo={};
    try{ salvo=JSON.parse(sessionStorage.getItem('ap_utm')||'{}'); }catch(_){}
    var atual={}; CHAVES.forEach(function(k){ if(q.get(k)) atual[k]=q.get(k); });
    if(Object.keys(atual).length){ salvo=atual; try{ sessionStorage.setItem('ap_utm',JSON.stringify(salvo)); }catch(_){} }
    if(!Object.keys(salvo).length) return;
    function anexar(a){
      var u=new URL(a.getAttribute('href'),location.origin);
      Object.keys(salvo).forEach(function(k){ if(!u.searchParams.has(k)) u.searchParams.set(k,salvo[k]); });
      a.setAttribute('href',u.origin===location.origin?u.pathname+u.search+u.hash:u.href);
    }
    document.querySelectorAll('a[href^="/wa/"],a[data-vt-link]').forEach(anexar);
    window.__utm=salvo;
  })();

  // ---- Conversão: todo clique que leva ao WhatsApp vira evento ----
  document.querySelectorAll('a[href^="/wa/"]').forEach(function(a){
    a.addEventListener('click',function(){
      var origem=(a.getAttribute('href').split('src=')[1]||'link').split('&')[0];
      if(window.gtag){
        gtag('event','contato_whatsapp',{empreendimento:EMP,botao:origem});
        if(ADS_CONV) gtag('event','conversion',{send_to:ADS_CONV});
      }
      if(window.fbq) fbq('track','Contact',{content_name:EMP,source:origem});
    });
  });

  // ---- Visualizador em tela cheia ----
  (function(){
    var box=document.getElementById('lbx'), img=document.getElementById('lbxImg'),
        cap=document.getElementById('lbxCap'), num=document.getElementById('lbxN'),
        stage=document.getElementById('lbxStage');
    if(!box) return;
    var lista=[], idx=0, voltarPara=null;

    function mostrar(){
      var it=lista[idx]; if(!it) return;
      img.src=it.url; img.alt=it.cap||'';
      cap.textContent=it.cap||'';
      num.textContent=(idx+1)+' / '+lista.length;
      box.classList.toggle('solo', lista.length<2);
      // pre-carrega vizinhas para a troca ser instantanea
      [idx+1, idx-1].forEach(function(j){
        var v=lista[(j+lista.length)%lista.length];
        if(v&&v.url){ var pre=new Image(); pre.src=v.url; }
      });
    }
    function abrir(itens,i,origem,planta){
      lista=itens.filter(function(x){return x&&x.url;});
      box.classList.toggle('planta', !!planta);
      if(!lista.length) return;
      idx=Math.max(0,Math.min(i||0,lista.length-1));
      voltarPara=origem||null;
      box.hidden=false;
      document.body.style.overflow='hidden';
      mostrar();
      document.getElementById('lbxX').focus();
    }
    function fechar(){
      box.hidden=true; img.src='';
      document.body.style.overflow='';
      if(voltarPara&&voltarPara.focus) voltarPara.focus();
    }
    function ir(passo){ if(lista.length<2) return; idx=(idx+passo+lista.length)%lista.length; mostrar(); }

    document.querySelectorAll('[data-lb]').forEach(function(el){
      el.addEventListener('click',function(){ abrir(FOTOS, parseInt(el.getAttribute('data-lb'),10)||0, el); });
    });
    document.querySelectorAll('[data-lbp]').forEach(function(el){
      el.addEventListener('click',function(){
        var todas=PLANTAS.filter(function(x){return x.url;});
        var alvo=PLANTAS[parseInt(el.getAttribute('data-lbp'),10)||0];
        abrir(todas, Math.max(0,todas.indexOf(alvo)), el, true);
      });
    });

    document.getElementById('lbxX').addEventListener('click',fechar);
    document.getElementById('lbxPrev').addEventListener('click',function(){ir(-1);});
    document.getElementById('lbxNext').addEventListener('click',function(){ir(1);});
    box.addEventListener('click',function(ev){ if(ev.target===box||ev.target===stage) fechar(); });
    addEventListener('keydown',function(ev){
      if(box.hidden) return;
      if(ev.key==='Escape') fechar();
      else if(ev.key==='ArrowLeft') ir(-1);
      else if(ev.key==='ArrowRight') ir(1);
    });
    // arrastar com o dedo no celular
    var x0=null,y0=null;
    stage.addEventListener('touchstart',function(ev){ x0=ev.touches[0].clientX; y0=ev.touches[0].clientY; },{passive:true});
    stage.addEventListener('touchend',function(ev){
      if(x0===null) return;
      var dx=ev.changedTouches[0].clientX-x0, dy=ev.changedTouches[0].clientY-y0;
      if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)) ir(dx<0?1:-1);
      else if(dy>90) fechar();
      x0=null;
    },{passive:true});
  })();


  var CALMO=matchMedia('(prefers-reduced-motion: reduce)').matches, CEL=matchMedia('(max-width: 760px)');

  // ---- Plantas no celular: carrossel 3D infinito ----
  // A planta da frente fica inteira; as vizinhas aparecem menores, giradas e
  // esmaecidas dos lados. Gira sozinho, aceita arrastar, e tocar numa vizinha
  // traz ela para a frente (só a da frente abre a planta ampliada).
  (function(){
    var box=document.querySelector('[data-cf]'); if(!box) return;
    var cards=[].slice.call(box.querySelectorAll('.plant')), n=cards.length; if(n<2) return;
    var nav=document.createElement('div'); nav.className='cf-nav';
    nav.innerHTML='<button type="button" aria-label="Planta anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 5l-7 7 7 7"/></svg></button>'+
      '<div class="cf-prog"><span class="cf-cont"></span><span class="cf-bar"><i></i></span></div>'+
      '<button type="button" aria-label="Próxima planta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 5l7 7-7 7"/></svg></button>';
    box.parentNode.insertBefore(nav, box.nextSibling);
    var bar=nav.querySelector('.cf-bar i'), cont=nav.querySelector('.cf-cont');
    var atual=0, timer=null, TEMPO=3600, ligado=false, visto=false;
    function off(i){ var d=(i-atual)%n; if(d<0) d+=n; if(d>n/2) d-=n; return d; }
    function pintar(){
      if(!ligado) return;
      cards.forEach(function(c,i){
        var d=off(i), a=Math.abs(d);
        c.style.transform='translateX(calc(-50% + '+(d*62)+'%)) translateZ('+(-a*120)+'px) rotateY('+(-d*24)+'deg) scale('+(1-a*.1)+')';
        c.style.opacity=a>1.5?0:(a?.55:1);
        c.style.zIndex=10-a;
        c.style.pointerEvents=a>1.5?'none':'';
        c.classList.toggle('ativa',d===0);
      });
      box.style.height=(Math.max.apply(null,cards.map(function(c){return c.offsetHeight;}))+40)+'px';
      cont.innerHTML=String(atual+1).padStart(2,'0')+' <small>/ '+String(n).padStart(2,'0')+'</small>';
      bar.classList.remove('anda'); void bar.offsetWidth;
      if(timer){ bar.style.animationDuration=TEMPO+'ms'; bar.classList.add('anda'); }
    }
    function ir(i){ atual=((i%n)+n)%n; pintar(); }
    function iniciar(){ clearInterval(timer); timer=null; if(!CALMO&&ligado){ timer=setInterval(function(){ ir(atual+1); },TEMPO); } pintar(); }
    function ligar(){
      ligado=CEL.matches; box.classList.toggle('cf',ligado);
      if(!ligado){ clearInterval(timer); timer=null; box.style.height=''; cards.forEach(function(c){ c.style.cssText=''; c.classList.remove('ativa'); }); return; }
      pintar(); if(visto) iniciar();
    }
    // Toque numa vizinha: traz para a frente em vez de abrir a planta.
    box.addEventListener('click',function(ev){
      if(!ligado) return;
      var c=ev.target.closest('.plant'); if(!c||c.classList.contains('ativa')) return;
      ev.preventDefault(); ev.stopPropagation(); ir(cards.indexOf(c)); iniciar();
    },true);
    nav.children[0].addEventListener('click',function(){ ir(atual-1); iniciar(); });
    nav.children[2].addEventListener('click',function(){ ir(atual+1); iniciar(); });
    var x0=null;
    box.addEventListener('touchstart',function(e){ x0=e.touches[0].clientX; clearInterval(timer); },{passive:true});
    box.addEventListener('touchend',function(e){ if(x0!==null){ var dx=e.changedTouches[0].clientX-x0; if(Math.abs(dx)>40) ir(atual+(dx<0?1:-1)); } x0=null; iniciar(); },{passive:true});
    // Entrada: as plantas sobem de baixo e se encaixam no carrossel.
    if(!CALMO) box.classList.add('cf-pre');
    new IntersectionObserver(function(es){ es.forEach(function(e){
      if(e.isIntersecting){ if(!visto){ visto=true; cards.forEach(function(c){ var a=Math.abs(off(cards.indexOf(c))); c.style.transitionDelay=(a*110)+'ms'; }); box.classList.remove('cf-pre'); setTimeout(function(){ cards.forEach(function(c){ c.style.transitionDelay=''; }); },900); } iniciar(); }
      else { clearInterval(timer); timer=null; }
    }); },{threshold:.25}).observe(box);
    (CEL.addEventListener?CEL.addEventListener('change',ligar):CEL.addListener(ligar));
    addEventListener('resize',function(){ if(ligado) pintar(); });
    ligar();
  })();

  // ---- Lazer no celular: órbita com um item em destaque por vez ----
  (function(){
    var orb=document.querySelector('[data-orbita]'); if(!orb) return;
    var bolhas=[].slice.call(orb.querySelectorAll('.bolha')).sort(function(a,b){ return a.dataset.i-b.dataset.i; });
    var hub=orb.querySelector('.hub-in'), ic=orb.querySelector('.hub-ic'), t=orb.querySelector('.hub-t'), sb=orb.querySelector('.hub-s');
    var atual=-1, timer=null, n=bolhas.length;
    function mostrar(i){
      atual=((i%n)+n)%n; var b=bolhas[atual];
      bolhas.forEach(function(x){ x.classList.toggle('on',x===b); });
      hub.classList.add('troca');
      setTimeout(function(){
        ic.innerHTML=b.querySelector('span').innerHTML; ic.className='hub-ic '+[].filter.call(b.classList,function(c){return c.indexOf('cor-')===0;}).join(' ');
        t.textContent=b.dataset.t; sb.textContent=b.dataset.s||'';
        hub.classList.remove('troca');
      }, atual===0&&!timer?0:220);
    }
    function iniciar(){ clearInterval(timer); timer=null; if(!CALMO) timer=setInterval(function(){ mostrar(atual+1); },2300); }
    bolhas.forEach(function(b,i){ b.addEventListener('click',function(){ mostrar(i); iniciar(); }); });
    mostrar(0);
    new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting) iniciar(); else { clearInterval(timer); timer=null; } }); },{threshold:.3}).observe(orb);
  })();

  // Mapa do Google: ~600 KB de scripts. Só carrega quando a pessoa chega
  // perto dele (o loading="lazy" do navegador começava longe demais).
  (function(){
    var f=document.querySelector('.map-frame[data-src]'); if(!f) return;
    function carregar(){ if(!f.src) f.src=f.getAttribute('data-src'); }
    if(!('IntersectionObserver' in window)) return carregar();
    var o=new IntersectionObserver(function(es){ if(es[0].isIntersecting){ carregar(); o.disconnect(); } },{rootMargin:'300px 0px'});
    o.observe(f);
  })();

  // Mapa próprio: só o empreendimento e os pontos da legenda, cada um com o
  // ícone dele, sobre um mapa claro sem comércios (OpenFreeMap, sem chave).
  // A biblioteca só carrega quando a pessoa chega perto da seção.
  (function(){
    var el=document.getElementById('mapaLeaf'); if(!el||!MAPA) return;
    var chips=[].slice.call(document.querySelectorAll('.poi-chip[data-poi]'));
    var card=el.parentNode.querySelector('.card');
    var LIB='https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/4.7.1/maplibre-gl.min';
    function margem(){ var b=card?card.offsetHeight+44:60; return {top:70,left:50,right:50,bottom:Math.min(b,el.clientHeight*.55)}; }
    // Sem WebGL (aparelho antigo) ou sem a biblioteca: volta ao mapa do Google.
    function google(){
      el.innerHTML='<iframe class="map-frame" referrerpolicy="no-referrer-when-downgrade" title="Mapa de localização"></iframe>';
      el.firstChild.src='https://www.google.com/maps?q='+MAPA.lat+','+MAPA.lon+'&z=16&hl=pt-BR&output=embed';
    }
    function webgl(){ try{ var c=document.createElement('canvas'); return !!(c.getContext('webgl2')||c.getContext('webgl')); }catch(e){ return false; } }
    function montar(){
      if(!window.maplibregl||!webgl()) return google();
      try{ montarMapa(); }catch(e){ el.innerHTML=''; google(); }
    }
    function montarMapa(){
      var ml=window.maplibregl, base=[MAPA.lon,MAPA.lat];
      var mapa=new ml.Map({container:el,style:'https://tiles.openfreemap.org/styles/positron',center:base,zoom:15,
        cooperativeGestures:true,attributionControl:{compact:true},
        locale:{'CooperativeGesturesHandler.WindowsHelpText':'Use Ctrl + rolagem para aproximar o mapa',
                'CooperativeGesturesHandler.MacHelpText':'Use ⌘ + rolagem para aproximar o mapa',
                'CooperativeGesturesHandler.MobileHelpText':'Use dois dedos para mover o mapa',
                'NavigationControl.ZoomIn':'Aproximar','NavigationControl.ZoomOut':'Afastar'}});
      mapa.addControl(new ml.NavigationControl({showCompass:false}),'top-right');
      var emp=document.createElement('div'); emp.className='mk-emp-box';
      var nome=document.createElement('span'); nome.className='mk-emp-nome'; nome.textContent=MAPA.nome; emp.appendChild(nome);
      emp.insertAdjacentHTML('beforeend','<div class="mk-emp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/></svg></div>');
      new ml.Marker({element:emp,anchor:'bottom'}).setLngLat(base).addTo(mapa);
      emp.style.zIndex='3';   // o empreendimento fica sempre por cima dos pontos
      var marcas=[], limites=new ml.LngLatBounds(base,base);
      var dica=new ml.Popup({closeButton:false,closeOnClick:false,offset:24,className:'mk-tip'});
      MAPA.pontos.forEach(function(p,i){
        if(p.lat==null) return;
        var d=document.createElement('button'); d.type='button'; d.className='mk-poi'; d.textContent=p.ic; d.setAttribute('aria-label',p.nome);
        d.addEventListener('mouseenter',function(){ ativar(i,false); });
        d.addEventListener('click',function(ev){ ev.stopPropagation(); ativar(i,false); });
        marcas[i]={el:d,ll:[p.lon,p.lat],p:p,m:new ml.Marker({element:d}).setLngLat([p.lon,p.lat]).addTo(mapa)};
        limites.extend([p.lon,p.lat]);
      });
      var linhaPronta=false;
      function linha(ll){
        var dado={type:'Feature',geometry:{type:'LineString',coordinates:ll?[base,ll]:[]}};
        if(linhaPronta){ mapa.getSource('rota').setData(dado); return; }
        if(!mapa.isStyleLoaded()) return mapa.once('load',function(){ linha(ll); });
        mapa.addSource('rota',{type:'geojson',data:dado});
        mapa.addLayer({id:'rota',type:'line',source:'rota',layout:{'line-cap':'round'},
          paint:{'line-color':getComputedStyle(el).getPropertyValue('--green').trim()||'#0E9E4A','line-width':2.5,'line-dasharray':[1.5,2.5]}});
        linhaPronta=true;
      }
      function ativar(i,mover){
        var a=marcas[i]; if(!a) return;
        marcas.forEach(function(x,j){ if(x) x.el.classList.toggle('on',j===i); });
        chips.forEach(function(c){ c.classList.toggle('on',+c.getAttribute('data-poi')===i); });
        var t=document.createElement('div'), b=document.createElement('b'); b.textContent=a.p.nome; t.appendChild(b);
        if(a.p.dist){ var s=document.createElement('span'); s.textContent=a.p.dist; t.appendChild(s); }
        dica.setLngLat(a.ll).setDOMContent(t).addTo(mapa);
        linha(a.ll);
        if(mover&&!mapa.getBounds().contains(a.ll)) mapa.fitBounds(new ml.LngLatBounds(base,base).extend(a.ll),{padding:margem(),maxZoom:16});
      }
      chips.forEach(function(c){
        var i=+c.getAttribute('data-poi');
        c.addEventListener('click',function(){ ativar(i,true); });
        c.addEventListener('mouseenter',function(){ ativar(i,false); });
      });
      mapa.fitBounds(limites,{padding:margem(),maxZoom:16,duration:0});
    }
    function carregar(){
      if(window.maplibregl) return montar();
      var l=document.createElement('link'); l.rel='stylesheet'; l.href=LIB+'.css'; document.head.appendChild(l);
      var s=document.createElement('script'); s.src=LIB+'.js'; s.onload=montar; s.onerror=google; document.head.appendChild(s);
    }
    if(!('IntersectionObserver' in window)) return carregar();
    var o=new IntersectionObserver(function(es){ if(es[0].isIntersecting){ carregar(); o.disconnect(); } },{rootMargin:'400px 0px'});
    o.observe(el);
  })();

  // ---- "Conheça também" no celular: carrossel lateral que passa sozinho ----
  (function(){
    var tr=document.getElementById('outrosTrilho'), dots=document.getElementById('outrosDots');
    if(!tr) return;
    var cel=matchMedia('(max-width: 760px)'), cards=[].slice.call(tr.children), timer=null, pausa=0;
    function passo(){ return cards.length>1 ? cards[1].offsetLeft-cards[0].offsetLeft : tr.clientWidth; }
    function atual(){ return Math.round(tr.scrollLeft/Math.max(1,passo())); }
    function ultimo(){ return Math.max(0,Math.round((tr.scrollWidth-tr.clientWidth)/Math.max(1,passo()))); }
    function ir(i){ tr.scrollTo({left:i*passo(),behavior:CALMO?'auto':'smooth'}); }
    function pintar(){
      if(!cel.matches){ dots.innerHTML=''; return; }
      var n=ultimo()+1;
      if(dots.childElementCount!==n){ dots.innerHTML=''; for(var i=0;i<n;i++){ var b=document.createElement('button'); b.type='button'; b.dataset.i=i; dots.appendChild(b); } }
      var a=atual(); [].forEach.call(dots.children,function(b,i){ b.classList.toggle('on',i===a); });
    }
    function avancar(){ if(!cel.matches||Date.now()<pausa) return; var a=atual(); ir(a>=ultimo()?0:a+1); }
    function iniciar(){ clearInterval(timer); timer=null; if(!CALMO&&cel.matches) timer=setInterval(avancar,3500); }
    // Mexeu com o dedo: espera um pouco antes de voltar a passar sozinho.
    ['touchstart','pointerdown','wheel'].forEach(function(t){ tr.addEventListener(t,function(){ pausa=Date.now()+7000; },{passive:true}); });
    dots.addEventListener('click',function(ev){ var b=ev.target.closest('button'); if(b){ pausa=Date.now()+7000; ir(+b.dataset.i); } });
    var raf; tr.addEventListener('scroll',function(){ cancelAnimationFrame(raf); raf=requestAnimationFrame(pintar); },{passive:true});
    addEventListener('resize',pintar);
    (cel.addEventListener?cel.addEventListener('change',function(){ pintar(); iniciar(); }):cel.addListener(function(){ pintar(); iniciar(); }));
    new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting){ pintar(); iniciar(); } else { clearInterval(timer); timer=null; } }); },{threshold:.3}).observe(tr);
  })();

  var lf=document.getElementById('leadForm');
  if(lf){lf.addEventListener('submit',function(ev){
    ev.preventDefault();
    var d=new FormData(lf);
    if(window.gtag){
      gtag('event','envio_formulario',{empreendimento:EMP});
      if(ADS_CONV) gtag('event','conversion',{send_to:ADS_CONV});
    }
    if(window.fbq) fbq('track','Lead',{content_name:EMP});
    var msg='Olá! Meu nome é '+(d.get('nome')||'')+'. Tenho interesse em '+(d.get('interesse')||'')+' no empreendimento '+EMP+'.';
    if(d.get('tel')) msg+=' Meu telefone: '+d.get('tel')+'.';
    var extra=window.__utm?'&'+new URLSearchParams(window.__utm).toString():'';
    window.open(WA_URL+'?src=formulario&msg='+encodeURIComponent(msg)+extra,'_blank');
  });}
</script>
</body>
