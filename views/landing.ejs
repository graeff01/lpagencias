<section class="sec" id="local">
  <div class="wrap">
    <div class="sec-head rv"><div class="kick">Localização</div><h2 class="sec-h2">Onde fica o <%= e.nome %></h2><p class="lead">Veja onde fica o empreendimento e o que há por perto.</p></div>
    <% var mapQ = encodeURIComponent([e.endereco, e.bairro, e.cidade, 'RS'].filter(Boolean).join(', '));
       // Com o alfinete confirmado, o mapa é desenhado aqui (Leaflet) só com o
       // empreendimento e os pontos da legenda; sem ele, fica o mapa do Google.
       var temCoord = function(o){ return o && isFinite(parseFloat(o.lat)) && isFinite(parseFloat(o.lon)); };
       var mapaProprio = temCoord(e);
       var pontos = (e.pois||[]).filter(function(p){ return p && p.label; }).map(function(p){
         var m = String(p.label).match(/^([^\p{L}\p{N}\s]+)\s*(.*)$/u);
         var ic = m ? m[1] : '📍', resto = m ? m[2] : String(p.label);
         var partes = resto.split(/\s*·\s*/);
         return { label: p.label, ic: ic, nome: partes[0], dist: partes.slice(1).join(' · '),
                  lat: temCoord(p) ? +parseFloat(p.lat).toFixed(6) : null, lon: temCoord(p) ? +parseFloat(p.lon).toFixed(6) : null };
       }); %>
    <div class="map rv">
      <% if (mapaProprio) { %>
      <div class="map-leaf" id="mapaLeaf" role="region" aria-label="Mapa do <%= e.nome %> e pontos próximos"></div>
      <noscript><iframe class="map-frame" src="https://www.google.com/maps?q=<%= mapQ %>&z=16&hl=pt-BR&output=embed" title="Mapa de localização"></iframe></noscript>
      <% } else { %>
      <iframe class="map-frame" data-src="https://www.google.com/maps?q=<%= mapQ %>&z=16&hl=pt-BR&output=embed" referrerpolicy="no-referrer-when-downgrade" title="Mapa de localização"></iframe>
      <noscript><iframe class="map-frame" src="https://www.google.com/maps?q=<%= mapQ %>&z=16&hl=pt-BR&output=embed" title="Mapa de localização"></iframe></noscript>
      <% } %>
      <div class="card"><b><%= e.endereco || e.nome %></b><span><%= [e.bairro, e.cidade].filter(Boolean).join(' · ') %></span>
        <a class="rota" href="https://www.google.com/maps/search/?api=1&query=<%= mapaProprio ? (parseFloat(e.lat) + ',' + parseFloat(e.lon)) : mapQ %>" target="_blank" rel="noopener">Como chegar</a></div>
    </div>
    <% if (pontos.length) { %>
    <div class="poi-list rv">
      <% pontos.forEach(function(p, i){ %><% if (mapaProprio && p.lat != null) { %><button type="button" class="poi-chip" data-poi="<%= i %>"><%= p.label %></button><% } else { %><span class="poi-chip"><%= p.label %></span><% } %><% }); %>
    </div>
    <% if (pontos.some(function(p){ return /·\s*[\d,]+\s*(m|km)\b/.test(p.label || ''); })) { %><p class="poi-nota">Distâncias aproximadas, em linha reta a partir do empreendimento.</p><% } %>
