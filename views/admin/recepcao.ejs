<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
  <%
    var rotulo = periodos.find(function(p){ return p[0] === per.chave; })[1];
    var fmt = function(d){ return d ? new Date(d).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—'; };
    var tel = function(t){ return t.replace(/^55(\d{2})(\d{4,5})(\d{4})$/, '($1) $2-$3'); };
    var maxEnv = linhas.reduce(function(m, l){ return Math.max(m, l.envios); }, 0);
    var erroBox = 'background:#fdf0ee;border-color:#f3c9c1;color:#b5432f';
  %>
  <header class="topbar">
    <a class="brand" href="/admin"><span class="m"><svg viewBox="0 0 24 24" fill="none"><path d="M4 11L12 4l8 7v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1v-8Z" fill="#fff"/></svg></span><span>Auxiliadora<small>Painel de empreendimentos</small></span></a>
    <nav class="tabs"><a href="/admin">Empreendimentos</a><a href="/admin/portal">Portal</a><a href="/admin/equipes">Equipes</a><a href="/admin/recepcao" class="on">Recepção</a><a href="/admin/auditoria">Auditoria</a></nav>
    <div class="sp"></div>
    <div class="top-links">
      <form method="POST" action="/admin/logout"><button class="btn btn-ghost btn-sm" type="submit">Sair</button></form>
    </div>
  </header>

  <div class="wrap">
    <div class="page-head">
      <div>
        <div class="eyebrow">Recepção</div>
        <h1>Encaminhamento de leads</h1>
        <p>A recepção entra em <b>/gestor</b> e vê esta lista de corretores. Ao tocar num nome, o WhatsApp abre com o lead pronto para enviar, e o envio é contado aqui.</p>
      </div>
    </div>

    <% if (q.ok) { %><div class="flash">Alterações salvas.</div><% } %>
    <% if (q.del) { %><div class="flash" style="<%= erroBox %>">Corretor removido da lista. Os envios dele continuam no total.</div><% } %>
    <% if (q.importados !== undefined) { %><div class="flash"><%= q.importados %> corretor(es) importado(s) das roletas.</div><% } %>
    <% if (q.erro === 'campos') { %><div class="flash" style="<%= erroBox %>">Informe o nome do corretor.</div><% } %>
    <% if (q.erro === 'telefone') { %><div class="flash" style="<%= erroBox %>">WhatsApp inválido. Use DDD + número, ex.: (51) 99999-0000.</div><% } %>
    <% if (q.erro === 'duplicado') { %><div class="flash" style="<%= erroBox %>">Esse WhatsApp já está na lista.</div><% } %>
    <% if (!recepcionistas.length) { %>
      <div class="warn-box">Ninguém tem acesso de recepção ainda. Crie em <a href="/admin/equipes" style="font-weight:700;text-decoration:underline">Equipes</a> com o tipo <b>Recepção</b>.</div>
    <% } %>

    <nav class="chips" style="margin-bottom:18px" aria-label="Período">
      <% periodos.forEach(function(p){ %>
        <a class="chip <%= p[0] === per.chave ? 'on' : '' %>" href="/admin/recepcao?periodo=<%= p[0] %>"><%= p[1] %></a>
      <% }); %>
    </nav>

    <div style="margin:-6px 0 18px"><a class="btn btn-ghost btn-sm" href="/admin/recepcao/csv?periodo=<%= per.chave %>">Exportar leads do período (CSV)</a></div>

    <% if (caixaAlerta) { %>
      <div class="<%= caixaAlerta.grave ? 'flash' : 'warn-box' %>" <% if (caixaAlerta.grave) { %>style="background:#fdf0ee;border-color:#f3c9c1;color:#b5432f"<% } %>><b style="margin-right:4px"><%= caixaAlerta.grave ? 'Caixa de leads parada:' : 'Aviso:' %></b> <%= caixaAlerta.texto %></div>
    <% } %>

    <div class="panel">
      <h2 class="panel-h">Fechamento · <%= rotulo.toLowerCase() %>
        <span class="sub" style="margin-left:auto;font-weight:600;font-size:12.5px;color:<%= fech.fecha ? '#0d7a3f' : 'var(--danger)' %>"><%= fech.fecha ? '✓ a conta fecha: nenhum lead de e-mail sem destino' : 'a conta não fecha: confira' %></span></h2>
      <div class="fech">
        <div><span>Chegaram por e-mail</span><b><%= fech.chegaram %></b></div>
        <div><span>Encaminhados</span><b><%= fech.encaminhados %></b></div>
        <div><span>Descartados</span><b><%= fech.descartados %></b></div>
        <div><span>Pendentes</span><b style="<%= fech.pendentes ? 'color:var(--danger)' : '' %>"><%= fech.pendentes %></b></div>
        <div><span>Colados à mão</span><b><%= fech.manuais %></b></div>
        <div><span>Formulários das landings</span><b><%= fech.formulariosLp %></b></div>
      </div>
      <div class="fech-det">
        <div>
          <h4>Tempo de espera na fila</h4>
          <p>Da chegada do e-mail até o encaminhamento: <b><%= fech.esperaMedia == null ? '—' : duracao(fech.esperaMedia) %></b> em média.</p>
          <p><b style="<%= fech.acima30 ? 'color:var(--danger)' : '' %>"><%= fech.acima30 %></b> esperaram mais de 30 min · <b><%= fech.foraHorario %></b> chegaram fora do horário (seg. a sáb., 8h às 19h).</p>
          <% fech.porPessoa.forEach(function(p){ %><p class="sub"><%= p.nome %>: <%= p.n %> encaminhado(s), espera média <%= duracao(p.media) %></p><% }); %>
        </div>
        <div>
          <h4>Descartes</h4>
          <% if (!fech.descartados) { %><p class="sub">Nenhum descarte no período.</p><% } %>
          <% fech.motivos.forEach(function(m){ %><p><b><%= m.n %></b> · <%= m.motivo %></p><% }); %>
          <% fech.listaDescartes.forEach(function(d){ %>
            <p class="sub"><%= fmt(d.tratado_em) %> · <% if (d.dados.telefone) { %><a href="/admin/auditoria/lead?tel=<%= d.dados.telefone %>" style="text-decoration:underline"><%= d.dados.nome || d.assunto || 'sem nome' %></a><% } else { %><%= d.dados.nome || d.assunto || 'sem nome' %><% } %> · “<%= d.motivo %>”</p>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="kpis">
      <div class="kpi"><span>Envios · <%= rotulo.toLowerCase() %></span><b><%= total %></b><i>leads encaminhados pela recepção</i></div>
      <div class="kpi"><span>Corretores na lista</span><b><%= linhas.filter(function(l){ return l.ativo; }).length %></b><i><%= linhas.length %> cadastrado(s)</i></div>
      <div class="kpi"><span>Receberam</span><b><%= linhas.filter(function(l){ return l.envios; }).length %></b><i>corretores com ao menos 1 envio</i></div>
      <div class="kpi"><span>Canal principal</span><b style="font-size:20px;padding:6px 0"><%= canais.length ? canais[0].nome : '—' %></b><i><%= canais.length ? canais[0].n + ' envio(s)' : 'sem envios no período' %></i></div>
    </div>

    <div class="split">
      <div class="panel">
        <h2 class="panel-h">Corretores · envios <%= rotulo.toLowerCase() %></h2>
        <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Corretor</th><th>Envios</th><th></th><th>Último</th><th></th></tr></thead>
          <tbody>
            <% if (!linhas.length) { %><tr><td colspan="5" class="empty">Cadastre os corretores ao lado ou importe os que já estão nas roletas.</td></tr><% } %>
            <% linhas.forEach(function(l){ %>
              <tr class="<%= l.ativo ? '' : 'off' %>">
                <td><b><%= l.nome %></b><% if (l.destaque) { %><span class="tag" style="background:#fff2e2;color:#a4620f">gerente</span><% } %><% if (!l.ativo) { %><span class="tag pause">oculto</span><% } %><span class="sub mono"><%= tel(l.telefone) %></span></td>
                <td class="num big"><%= l.envios %></td>
                <td><div class="bar"><span style="width:<%= maxEnv ? (l.envios * 100 / maxEnv).toFixed(1) : 0 %>%"></span></div></td>
                <td class="sub"><%= fmt(l.ultimo) %></td>
                <td class="row-acts">
                  <button class="btn btn-ghost btn-sm" type="button" onclick='editar(<%- JSON.stringify({ id: l.id, nome: l.nome, telefone: tel(l.telefone), ativo: l.ativo, destaque: !!l.destaque }) %>)'>Editar</button>
                  <form method="POST" action="/admin/recepcao/corretor/<%= l.id %>/toggle"><button class="btn btn-ghost btn-sm" type="submit"><%= l.ativo ? 'Ocultar' : 'Mostrar' %></button></form>
                  <form method="POST" action="/admin/recepcao/corretor/<%= l.id %>/excluir" onsubmit="return confirm('Remover <%= l.nome %> da lista da recepção?')">
                    <button class="btn btn-danger btn-sm" type="submit" title="Remover"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>

      <div>
        <div class="panel">
          <h2 class="panel-h" id="c-titulo">Novo corretor</h2>
          <form class="frm" method="POST" action="/admin/recepcao/corretor" id="c-form">
            <input type="hidden" name="id" value="">
            <div class="fg"><label>Nome</label><input name="nome" required placeholder="Ex.: Marilane"></div>
            <div class="fg"><label>WhatsApp</label><input name="telefone" required placeholder="(51) 99999-0000" inputmode="tel"></div>
            <label class="chk"><input type="checkbox" name="ativo" checked> Aparece para a recepção</label>
            <label class="chk" style="margin-top:-8px"><input type="checkbox" name="destaque"> Gerente: aparece em destaque, no topo da lista</label>
            <div class="frm-acts">
              <button class="btn btn-green" type="submit">Salvar corretor</button>
              <button class="btn btn-ghost" type="button" onclick="limpar()">Limpar</button>
            </div>
          </form>
          <div class="panel-foot">
            <p class="hint">Quem já está em alguma roleta pode vir de uma vez, sem digitar de novo.</p>
            <form method="POST" action="/admin/recepcao/importar"><button class="btn btn-ghost btn-sm" type="submit">Importar das roletas</button></form>
          </div>
        </div>

        <div class="panel">
          <h2 class="panel-h">Formulário das landing pages</h2>
          <div class="frm">
            <p class="hint" style="margin-bottom:10px">Antes de abrir o WhatsApp, o visitante informa <b>nome, WhatsApp e interesse</b>. O corretor recebe tudo organizado, com protocolo, e o lead fica registrado na auditoria mesmo que a pessoa desista de mandar a mensagem. Quem já preencheu não vê o formulário de novo.</p>
            <form method="POST" action="/admin/recepcao/lp-formulario" style="display:flex;align-items:center;gap:10px">
              <span style="font-size:13.5px;font-weight:650"><%= lpFormulario ? '✓ Ligado' : 'Desligado' %></span>
              <input type="hidden" name="ligar" value="<%= lpFormulario ? '0' : '1' %>">
              <button class="btn btn-ghost btn-sm" type="submit"><%= lpFormulario ? 'Desligar' : 'Ligar' %></button>
            </form>
          </div>
        </div>

        <div class="panel">
          <h2 class="panel-h">Caixa de leads (e-mail)</h2>
          <div class="frm">
            <%
              var cs = caixaStatus;
              var ativo = cs.gmailEmail || cs.imap || cs.webhook;
              var msgs = { conectado: 'Gmail conectado. A primeira leitura já começou.', desconectado: 'Gmail desconectado.', recusado: 'A conexão foi cancelada na tela do Google.',
                falhou: 'Não foi possível conectar. Tente de novo.', 'sem-google': 'Falta configurar GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET no Railway.',
                verificado: (q.n || 0) + ' lead(s) novo(s) importado(s).', erro: 'A verificação deu erro (veja abaixo).' };
            %>
            <% if (q.caixa && msgs[q.caixa]) { %><div class="flash" style="margin-bottom:12px<%= /falhou|recusado|sem-google|erro/.test(q.caixa) ? ';background:#fdf0ee;border-color:#f3c9c1;color:#b5432f' : '' %>"><%= msgs[q.caixa] %></div><% } %>
            <p class="hint" style="margin-bottom:10px">Os e-mails com o marcador <b><%= cs.rotulo %></b> entram sozinhos na fila “A encaminhar” da recepção, a cada <%= cs.intervalo %> s. O sistema só lê: não apaga, não move e não marca nada.</p>
            <p style="font-size:13px;margin-bottom:6px"><b>Na fila agora:</b> <%= pendentes %> lead(s) esperando</p>
            <% if (cs.gmailEmail) { %>
              <p style="font-size:13px;margin-bottom:8px">✓ Gmail conectado (só leitura): <b><%= cs.gmailEmail %></b></p>
              <form method="POST" action="/admin/recepcao/gmail/desconectar" onsubmit="return confirm('Desconectar o Gmail? A fila para de receber e-mails.')"><button class="btn btn-ghost btn-sm" type="submit">Desconectar Gmail</button></form>
            <% } else if (cs.gmailDisponivel) { %>
              <a class="btn btn-green btn-sm" href="/admin/recepcao/gmail/conectar">Conectar Gmail (só leitura)</a>
            <% } %>
            <% if (cs.imap) { %><p style="font-size:13px;margin-top:8px">✓ Caixa via senha de app: <b><%= cs.imap %></b></p><% } %>
            <% if (cs.webhook) { %><p style="font-size:13px;margin-top:8px">✓ Recebimento por webhook: <span class="mono" style="font-size:11.5px"><%= baseUrl %>/entrada/email</span></p><% } %>
            <% if (!ativo && !cs.gmailDisponivel) { %>
              <div class="warn-box" style="margin:6px 0 0">Nenhuma caixa configurada ainda. Escolha uma forma e configure as variáveis no Railway (veja o README, seção “Caixa de leads”).</div>
            <% } %>
            <% if (ativo) { %>
              <form method="POST" action="/admin/recepcao/caixa/verificar" style="margin-top:10px"><button class="btn btn-ghost btn-sm" type="submit">Verificar agora</button></form>
              <p class="hint" style="margin-top:8px">Última leitura: <%= cs.ultima ? new Date(cs.ultima).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : 'ainda não' %></p>
              <% if (cs.erro) { %><p style="font-size:12.5px;color:var(--danger);margin-top:4px">Erro: <%= cs.erro %></p><% } %>
            <% } %>
          </div>
        </div>

        <div class="panel">
          <h2 class="panel-h">Campanhas na recepção</h2>
          <div class="frm">
            <p class="hint" style="margin-bottom:12px">A roleta do empreendimento vira uma aba na tela da recepção: ela envia sempre para o próximo da vez. A fila é a mesma da landing page.</p>
            <% campanhas.forEach(function(c){ %>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
                <b style="flex:1"><%= c.nome %></b><span class="sub" style="font-size:12px;color:var(--muted)"><%= c.ativos %> na roleta</span>
                <a class="btn btn-ghost btn-sm" href="/admin/corretores/<%= c.id %>">Roleta</a>
                <form method="POST" action="/admin/recepcao/campanha/<%= c.id %>/remover" onsubmit="return confirm('Tirar a campanha <%= c.nome %> da recepção? A roleta do empreendimento continua igual.')"><button class="btn btn-ghost btn-sm" type="submit">Tirar</button></form>
              </div>
            <% }); %>
            <form method="POST" action="/admin/recepcao/campanha" style="display:flex;gap:8px;margin-top:6px">
              <select name="empreendimento_id" class="sel" style="flex:1" required>
                <option value="">Adicionar empreendimento…</option>
                <% emps.filter(function(e){ return !campanhas.some(function(c){ return c.id === e.id; }); }).forEach(function(e){ %><option value="<%= e.id %>"><%= e.nome %></option><% }); %>
              </select>
              <button class="btn btn-green btn-sm" type="submit">Adicionar</button>
            </form>
          </div>
        </div>

        <div class="panel">
          <h2 class="panel-h">Por canal</h2>
          <div class="tbl-wrap">
          <table class="tbl">
            <tbody>
              <% if (!canais.length) { %><tr><td class="empty">Sem envios no período.</td></tr><% } %>
              <% canais.forEach(function(c){ %><tr><td><%= c.nome %></td><td class="num" style="text-align:right"><%= c.n %></td></tr><% }); %>
            </tbody>
          </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap" style="padding-top:0">
    <div class="panel">
      <h2 class="panel-h">Leads encaminhados · <%= rotulo.toLowerCase() %>
        <% if (conf.comLink) { %><span class="sub" style="margin-left:auto;font-weight:500;font-size:12.5px"><%= conf.confirmados %> de <%= conf.comLink %> confirmados pelo corretor<% if (conf.tempoMedio != null) { %> · tempo médio <%= duracao(conf.tempoMedio) %><% } %></span><% } %></h2>
      <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Quando</th><th>Cliente</th><th>Interesse</th><th>Origem</th><th>Corretor</th><th>Recebimento</th><th>Enviado por</th></tr></thead>
        <tbody>
          <% if (!leads.length) { %><tr><td colspan="7" class="empty">Nenhum lead encaminhado no período.</td></tr><% } %>
          <% leads.forEach(function(r){ %>
            <tr>
              <td class="sub"><%= fmt(r.created_at) %></td>
              <td><% if (r.lead_telefone) { %><a href="/admin/auditoria/lead?tel=<%= r.lead_telefone %>" title="Ver histórico do lead"><b style="text-decoration:underline;text-decoration-color:var(--line-strong)"><%= r.lead_nome || '—' %></b></a><% } else { %><b><%= r.lead_nome || '—' %></b><% } %><span class="sub mono"><%= r.lead_telefone ? tel(r.lead_telefone) : '' %></span><% if (r.lead_email) { %><span class="sub"><%= r.lead_email %></span><% } %></td>
              <td class="sub"><%= [r.negocio, r.imovel ? 'imóvel ' + r.imovel : ''].filter(Boolean).join(' · ') || '—' %><% if (r.mensagem) { %><span class="rc-msg" title="<%= r.mensagem %>"><%= r.mensagem %></span><% } %></td>
              <td class="sub"><%= [r.origem, r.canal].filter(Boolean).filter(function(v, i, a){ return a.indexOf(v) === i; }).join(' · ') || '—' %></td>
              <td><%= r.corretor_nome %></td>
              <td class="sub">
                <% if (r.confirmado_em) { %><span style="color:#0d7a3f;font-weight:650">✓ em <%= duracao((new Date(r.confirmado_em) - new Date(r.created_at)) / 60000) %></span>
                <% } else if (r.substituido_por) { %><span style="color:var(--danger)">não confirmou · reencaminhado</span>
                <% } else if (r.token) { %><span style="color:var(--danger)">sem confirmar</span><% if (r.cobrancas) { %><span class="sub">lembrado <%= r.cobrancas %>x</span><% } %>
                <% } else { %>—<% } %>
              </td>
              <td class="sub"><%= r.por %><% if (r.entrada_id) { %><span class="sub">da fila de e-mail</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  </div>

  <script>
    var f = document.getElementById('c-form'), el = f.elements;
    function editar(c) {
      el.id.value = c.id; el.nome.value = c.nome; el.telefone.value = c.telefone; el.ativo.checked = c.ativo; el.destaque.checked = c.destaque;
      document.getElementById('c-titulo').textContent = 'Editar ' + c.nome;
      f.scrollIntoView({ behavior: 'smooth', block: 'center' }); el.nome.focus();
    }
    function limpar() { f.reset(); el.id.value = ''; document.getElementById('c-titulo').textContent = 'Novo corretor'; }
  </script>
</body>
</html>
