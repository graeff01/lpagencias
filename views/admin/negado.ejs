<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/admin.css?v=<%= v %>">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/admin"><span class="m"><svg viewBox="0 0 24 24" fill="none"><path d="M4 11L12 4l8 7v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1v-8Z" fill="#fff"/></svg></span><span>Auxiliadora<small>Painel de empreendimentos</small></span></a>
    <div class="sp"></div>
    <div class="top-links">
      <form method="POST" action="/admin/logout"><button class="btn btn-ghost btn-sm" type="submit">Sair</button></form>
    </div>
  </header>
  <div class="wrap" style="max-width:640px">
    <div class="panel" style="padding:34px 28px;text-align:center;margin-top:40px">
      <div style="font-size:40px">🔒</div>
      <h1 style="font-size:21px;margin:10px 0 8px">Sem permissão</h1>
      <p style="color:var(--muted);line-height:1.55"><%= msg %></p>
      <div style="display:flex;gap:10px;justify-content:center;margin-top:20px">
        <a class="btn btn-ghost" href="javascript:history.back()">Voltar</a>
        <a class="btn btn-green" href="/admin">Ir para o painel</a>
      </div>
    </div>
  </div>
</body>
</html>
