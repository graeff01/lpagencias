# ===== Auxiliadora Landings — variáveis de ambiente =====

# Senha do painel /admin (obrigatório em produção)
ADMIN_PASSWORD=troque-esta-senha

# Senha de quem só cadastra empreendimentos (opcional). Não dá acesso a
# corretores, leads, exclusão nem à configuração do portal.
CADASTRO_PASSWORD=

# Segredo dos cookies de sessão (qualquer string longa e aleatória).
# Também gera o hash dos IPs no log de leads — o IP em si nunca é gravado (LGPD).
# Trocar este valor reinicia a deduplicação de leads por IP.
SESSION_SECRET=coloque-uma-string-longa-e-aleatoria-aqui

# Banco de dados PostgreSQL (o Railway injeta automaticamente ao adicionar o Postgres)
# Em local, se deixar vazio, o app usa um banco em memória (pg-mem) só para testes.
DATABASE_URL=

# Cloudinary — upload das fotos dos empreendimentos (crie conta grátis em cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Porta (o Railway define automaticamente; local usa 3000)
PORT=3000

# Domínio do portal (página principal). Opcional: sem ele, o portal usa o
# SITE_DOMINIO ou, se esse for o domínio de um empreendimento, o endereço
# padrão do Railway (<serviço>-<ambiente>.up.railway.app).
PORTAL_DOMINIO=

# ===== Caixa de leads (fila "A encaminhar" da recepção) =====
# Os e-mails com este marcador (Gmail) ou nesta pasta (IMAP) viram leads na fila.
LEADS_ROTULO=Leads
# Intervalo de leitura, em segundos (mínimo 30).
LEADS_INTERVALO_S=90

# Forma 1 — Gmail só leitura (recomendada). Depois de preencher, conecte em
# Painel → Recepção → "Conectar Gmail". Redirect URI no Google Cloud:
#   https://SEU-DOMINIO/admin/recepcao/gmail/retorno
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Endereço público do site (opcional; usado para montar o redirect acima).
PUBLIC_URL=

# Forma 2 — IMAP com senha de app (Gmail: imap.gmail.com).
LEADS_IMAP_HOST=imap.gmail.com
LEADS_IMAP_USER=
LEADS_IMAP_PASS=

# Forma 3 — webhook: outro serviço faz POST em /entrada/email com o
# cabeçalho X-Leads-Token igual a este valor.
LEADS_WEBHOOK_TOKEN=
